<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>traje_ironman_ai</name>
  <version>0.1.0</version>
  <description>ROS2 AI control system for EDF+RCS flight suit</description>

  <maintainer email="developer@traje-ironman.dev">Traje Ironman Team</maintainer>
  <license>MIT</license>

  <author email="developer@traje-ironman.dev">Traje Ironman Project</author>

  <url type="website">https://github.com/luclopez1/traje-ironman</url>
  <url type="repository">https://github.com/luclopez1/traje-ironman.git</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS2 Dependencies -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Python Dependencies -->
  <exec_depend>python3-filterpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv-python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

</package>
